#!/usr/bin/env python3
"""Generate the INT preset wallpapers (PNG) from the theme files, at build time.

Original procedural art (gradient, glow, large INT letters; petals for the
anime preset), released with INT under the MIT licence. No third-party image.
Usage: int-wallpaper-gen THEMES_DIR OUTPUT_DIR [WIDTH HEIGHT]
"""
import math
import os
import random
import struct
import sys
import zlib

# Original block letters (same shapes as the INT ASCII logo), 1 = filled.
LETTERS = [
    "111 11    11 11111111",
    "111 111   11    11   ",
    "111 11 1  11    11   ",
    "111 11  1 11    11   ",
    "111 11   111    11   ",
    "111 11    11    11   ",
]


def read_theme(path):
    values = {}
    with open(path, encoding="utf-8") as stream:
        for line in stream:
            if "=" in line and not line.lstrip().startswith("#"):
                key, value = line.split("=", 1)
                values[key.strip()] = value.strip()
    return values


def rgb(hexa):
    hexa = hexa.lstrip("#")
    return tuple(int(hexa[i:i + 2], 16) for i in (0, 2, 4))


def mix(a, b, t):
    return tuple(int(a[i] + (b[i] - a[i]) * t) for i in range(3))


def png(path, width, height, rows):
    raw = b"".join(b"\0" + bytes(row) for row in rows)

    def chunk(kind, body):
        return struct.pack(">I", len(body)) + kind + body + struct.pack(">I", zlib.crc32(kind + body))
    data = (b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0))
            + chunk(b"IDAT", zlib.compress(raw, 9)) + chunk(b"IEND", b""))
    with open(path, "wb") as stream:
        stream.write(data)


def render(theme, name, width, height):
    bg, bg_alt = rgb(theme["bg"]), rgb(theme["bg_alt"])
    accent, accent2 = rgb(theme["accent"]), rgb(theme["accent2"])
    cell = max(4, width // 120)
    cols, lines = len(LETTERS[0]), len(LETTERS)
    ox, oy = width - (cols + 4) * cell, height - (lines + 4) * cell
    glow_x, glow_y, glow_r = width * 0.72, height * 0.30, max(width, height) * 0.55
    rng = random.Random(name)
    petals = []
    if name == "anime":
        for _ in range(90):
            petals.append((rng.uniform(0, width), rng.uniform(0, height), rng.uniform(5, 16) * width / 1920,
                           rng.uniform(0, math.pi), rng.uniform(0.25, 0.6)))
    rows = []
    for y in range(height):
        row = bytearray()
        for x in range(width):
            t = (x / width * 0.35 + y / height * 0.65)
            colour = mix(bg, bg_alt, min(1.0, t))
            d = math.hypot(x - glow_x, y - glow_y) / glow_r
            if d < 1:
                colour = mix(colour, accent2, (1 - d) ** 2 * 0.18)
            gx, gy = (x - ox) // cell, (y - oy) // cell
            if 0 <= gy < lines and 0 <= gx < cols and LETTERS[gy][gx] == "1":
                colour = mix(colour, accent, 0.22)
            row.extend(colour)
        rows.append(row)
    for px, py, r, angle, strength in petals:
        ca, sa = math.cos(angle), math.sin(angle)
        for y in range(max(0, int(py - r)), min(height, int(py + r) + 1)):
            row = rows[y]
            for x in range(max(0, int(px - r)), min(width, int(px + r) + 1)):
                dx, dy = x - px, y - py
                u, v = (dx * ca + dy * sa) / r, (-dx * sa + dy * ca) / (r * 0.55)
                q = u * u + v * v
                if q < 1:
                    i = x * 3
                    blended = mix(tuple(row[i:i + 3]), accent, strength * (1 - q))
                    row[i:i + 3] = bytes(blended)
    return rows


def main(argv):
    if len(argv) not in (3, 5):
        print(__doc__.strip(), file=sys.stderr)
        return 2
    themes, out = argv[1], argv[2]
    width, height = (int(argv[3]), int(argv[4])) if len(argv) == 5 else (1920, 1080)
    os.makedirs(out, exist_ok=True)
    for file in sorted(os.listdir(themes)):
        if file.endswith(".theme"):
            name = file[:-6]
            theme = read_theme(os.path.join(themes, file))
            png(os.path.join(out, name + ".png"), width, height, render(theme, name, width, height))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
