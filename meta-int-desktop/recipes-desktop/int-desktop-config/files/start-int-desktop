#!/bin/sh
# The compositor remains the logged-in user. Device access belongs to logind.
set -eu
PATH=/usr/bin:/bin
export PATH
fail() { printf '%s\n' "$*" >&2; exit 1; }
[ "$#" -eq 0 ] || fail 'Usage: start-int-desktop'
uid=$(id -u)
[ "$uid" -ge 1000 ] && [ "$uid" -le 60000 ] || fail 'Log in with your owner account before starting the desktop.'
[ -n "${XDG_RUNTIME_DIR:-}" ] && [ -d "$XDG_RUNTIME_DIR" ] && [ ! -L "$XDG_RUNTIME_DIR" ] || fail 'Your login session is not ready. Log out and log in again.'
[ "$(stat -c '%u:%a' "$XDG_RUNTIME_DIR")" = "$uid:700" ] || fail 'Your login session is not ready. Log out and log in again.'
[ -n "${XDG_SESSION_ID:-}" ] || fail 'Log in on a local virtual console before starting the desktop.'
remote=$(loginctl show-session "$XDG_SESSION_ID" -p Remote --value) || fail 'Cannot read your login session. Log out and log in again.'
seat=$(loginctl show-session "$XDG_SESSION_ID" -p Seat --value) || fail 'Cannot read your login session. Log out and log in again.'
active=$(loginctl show-session "$XDG_SESSION_ID" -p Active --value) || fail 'Cannot read your login session. Log out and log in again.'
session_uid=$(loginctl show-session "$XDG_SESSION_ID" -p User --value) || fail 'Cannot read your login session. Log out and log in again.'
[ "$remote" = no ] && [ "$seat" = seat0 ] && [ "$active" = yes ] && [ "$session_uid" = "$uid" ] || fail 'Switch to your active local virtual console before starting the desktop.'
[ -z "${WAYLAND_DISPLAY:-}" ] || fail 'A desktop is already running in this session.'
# Retain a user's UTF-8 locale; give the terminal a working fallback otherwise.
if [ "$(locale charmap 2>/dev/null)" != UTF-8 ]; then
    unset LC_ALL
    LC_CTYPE=en_US.UTF-8
    export LC_CTYPE
fi
[ "$(locale charmap 2>/dev/null)" = UTF-8 ] || fail 'A UTF-8 language setting is required to start the desktop.'
export LIBSEAT_BACKEND=logind
export XDG_CURRENT_DESKTOP=sway
export XDG_SESSION_DESKTOP=int
export XDG_SESSION_TYPE=wayland
config_home=${XDG_CONFIG_HOME:-$HOME/.config}
# First desktop start: let the owner pick a look, then keep it.
if [ ! -f "$config_home/int/theme/current" ] && [ -t 0 ]; then
    case "$(sed -n 's/^INT_LANGUAGE=//p' /etc/int/install.conf 2>/dev/null)${LANG:-}" in
        fr*) printf '\nChoisis le theme de ton bureau (modifiable plus tard avec Super+t ou int-theme) :\n' ;;
        *) printf '\nChoose your desktop theme (change it later with Super+t or int-theme):\n' ;;
    esac
    int-theme list | awk '{ printf "  %d) %s\n", NR, $0 }'
    printf '> '
    IFS= read -r choice || choice=
    name=$(int-theme list | awk -v n="$choice" 'NR == n { print $1 }')
    int-theme set "${name:-dark}" >/dev/null || fail 'Cannot apply the desktop theme.'
fi
int-theme ensure || fail 'Cannot prepare the desktop theme.'
config=$config_home/sway/config
if [ ! -f "$config" ]; then config=/etc/int/sway/config; fi
exec dbus-run-session -- sway --config "$config"
