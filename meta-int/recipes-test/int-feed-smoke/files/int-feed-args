#!/bin/sh
# Emit the independently supplied test fingerprint after strict cmdline checks.
set -eu
test "$#" -ge 1 && test "$#" -le 2
mode=${2:-fingerprint}
case "$mode" in fingerprint|--case) ;; *) exit 1 ;; esac
fingerprint=
test_case=
fingerprint_seen=0
case_seen=0
set -f
for token in $(cat "$1"); do
    case "$token" in
        int_feed_fingerprint=*)
            test "$fingerprint_seen" -eq 0
            fingerprint_seen=1
            fingerprint=${token#int_feed_fingerprint=}
            ;;
        int_feed_case=*)
            test "$case_seen" -eq 0
            case_seen=1
            test_case=${token#int_feed_case=}
            ;;
    esac
done
case "$test_case" in success|stale-rpm-checksum|corrupt-rpm-indexed|unsigned-rpm|wrong-key-rpm|missing-metadata-signature|altered-repomd) ;; *) exit 1 ;; esac
printf '%s\n' "$fingerprint" | grep -Eq '^[0-9A-F]{40}$'
if test "$mode" = --case; then
    printf '%s\n' "$test_case"
else
    printf '%s\n' "$fingerprint"
fi
