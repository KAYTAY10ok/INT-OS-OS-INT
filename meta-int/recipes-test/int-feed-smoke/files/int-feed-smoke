#!/bin/sh
# Test-only local-feed guest. The host supplies the trusted fingerprint on the
# kernel command line and a separate read-only fixture disk on /dev/vdb.
set -eu
export LC_ALL=C
result=FAIL
finish() {
    if test "$result" != PASS; then
        echo 'INT_FEED_FAIL'
    fi
    echo 'INT_FEED_SHUTDOWN'
    sync
    systemctl --no-block poweroff
}
trap finish EXIT

fingerprint=$(/usr/libexec/int-feed-args /proc/cmdline)
test_case=$(/usr/libexec/int-feed-args /proc/cmdline --case)
work=/run/int-feed-smoke
mkdir -m 0700 "$work"
mkdir -m 0700 "$work/home" "$work/repos" "$work/cache" "$work/persist" "$work/mount"

# A QEMU read-only block device and read-only mount are both required.
attempt=0
while test ! -b /dev/vdb; do
    attempt=$((attempt + 1))
    test "$attempt" -lt 30
    sleep 1
done
cat > "$work/repos/intfeed-unsigned.repo" <<EOF
[intfeed-unsigned]
name=INT disposable unsigned package feed
baseurl=file://$work/mount/unsigned-rpm
enabled=0
gpgkey=file://$work/trusted.asc
gpgcheck=1
repo_gpgcheck=1
skip_if_unavailable=0
EOF
cat > "$work/repos/intfeed-wrong-key.repo" <<EOF
[intfeed-wrong-key]
name=INT disposable wrong-key package feed
baseurl=file://$work/mount/wrong-key-rpm
enabled=0
gpgkey=file://$work/trusted.asc
gpgcheck=1
repo_gpgcheck=1
skip_if_unavailable=0
EOF
cat > "$work/repos/intfeed-missing-signature.repo" <<EOF
[intfeed-missing-signature]
name=INT disposable missing metadata signature feed
baseurl=file://$work/mount/missing-metadata-signature
enabled=0
gpgkey=file://$work/trusted.asc
gpgcheck=1
repo_gpgcheck=1
skip_if_unavailable=0
EOF
cat > "$work/repos/intfeed-altered-repomd.repo" <<EOF
[intfeed-altered-repomd]
name=INT disposable altered metadata feed
baseurl=file://$work/mount/altered-repomd
enabled=0
gpgkey=file://$work/trusted.asc
gpgcheck=1
repo_gpgcheck=1
skip_if_unavailable=0
EOF
cat > "$work/repos/intfeed-corrupt.repo" <<EOF
[intfeed-corrupt]
name=INT disposable corrupt package feed
baseurl=file://$work/mount/corrupt-rpm-indexed
enabled=0
gpgkey=file://$work/trusted.asc
gpgcheck=1
repo_gpgcheck=1
skip_if_unavailable=0
EOF
cat > "$work/repos/intfeed-stale.repo" <<EOF
[intfeed-stale]
name=INT disposable stale package checksum feed
baseurl=file://$work/mount/stale-rpm-checksum
enabled=0
gpgkey=file://$work/trusted.asc
gpgcheck=1
repo_gpgcheck=1
skip_if_unavailable=0
EOF
cat > "$work/repos/intfeed-primary.repo" <<EOF
[intfeed-primary]
name=INT disposable altered primary metadata feed
baseurl=file://$work/mount/altered-primary
enabled=0
gpgkey=file://$work/trusted.asc
gpgcheck=1
repo_gpgcheck=1
skip_if_unavailable=0
EOF
cat > "$work/repos/intfeed-unknown.repo" <<EOF
[intfeed-unknown]
name=INT disposable untrusted metadata signer feed
baseurl=file://$work/mount/wrong-key-metadata
enabled=0
gpgkey=file://$work/trusted.asc
gpgcheck=1
repo_gpgcheck=1
skip_if_unavailable=0
EOF
test "$(cat /sys/block/vdb/ro)" = 1
mount -t ext4 -o ro,nosuid,nodev,noexec /dev/vdb "$work/mount"
key="$work/mount/trusted-public-key.asc"
test -f "$key"
size=$(wc -c < "$key")
test "$size" -gt 0
test "$size" -le 65536
cp "$key" "$work/trusted.asc"

# Show-only parses key material without importing it into any trust store.
# The fixture format uses a single, unexpired primary key and no subkeys.
gpg --batch --no-options --homedir "$work/home" --with-colons --show-keys \
    "$work/trusted.asc" > "$work/key-list"
/usr/libexec/int-feed-keycheck "$work/key-list" "$fingerprint" "$(date +%s)"
echo 'INT_FEED_CHECK:pin:PASS'

# Only the pinned local public key is made available for either RPM or DNF.
rpm --import "$work/trusted.asc"
cat > "$work/dnf.conf" <<EOF
[main]
reposdir=$work/repos
cachedir=$work/cache
persistdir=$work/persist
plugins=0
gpgcheck=1
localpkg_gpgcheck=1
assumeyes=1
EOF
for version in 1 2; do
    cat > "$work/repos/intfeed-v$version.repo" <<EOF
[intfeed-v$version]
name=INT disposable feed $version
baseurl=file://$work/mount/valid-v$version
enabled=0
gpgkey=file://$work/trusted.asc
gpgcheck=1
repo_gpgcheck=1
skip_if_unavailable=0
EOF
done

check_version() {
    test "$(rpm -q --qf '%{VERSION}\n' int-feed-probe)" = "$1"
    test "$(cat /usr/share/int-feed-probe/version)" = "$1"
    test "$(wc -c < /usr/share/int-feed-probe/version)" -eq 4
}
if rpm -q int-feed-probe >/dev/null 2>&1; then
    echo 'Probe package was already installed' >&2
    exit 1
fi
dnf -c "$work/dnf.conf" --disablerepo='*' --enablerepo=intfeed-v1 --refresh makecache
dnf -c "$work/dnf.conf" --disablerepo='*' --enablerepo=intfeed-v1 install int-feed-probe-1.0
check_version 1.0
echo 'INT_FEED_CHECK:install-v1:PASS'
if test "$test_case" = empty-rpm-trust; then
    # Isolate the RPM trust database from both installed packages and DNF's
    # automatic import of the configured local key. Use the exact same signed
    # artifact before and after importing only the independently pinned key.
    db="$work/empty-rpm-db"
    mkdir -m 0700 "$db"
    rpm --dbpath "$db" --initdb
    test -z "$(rpm --dbpath "$db" -qa)"
    echo 'INT_FEED_CHECK:empty-rpm-db:PASS'
    package="$work/mount/valid-v2/int-feed-probe-2.0-r0.noarch.rpm"
    if rpmkeys --dbpath "$db" --define '_pkgverify_level all' --checksig --verbose \
        "$package" > "$work/empty-rpmkeys.log" 2>&1; then
        echo 'Signed package unexpectedly trusted by an empty RPM database' >&2
        exit 1
    fi
    cat "$work/empty-rpmkeys.log"
    grep -Eiq 'signature.*:[[:space:]]*NOKEY[[:space:]]*$' "$work/empty-rpmkeys.log"
    grep -Eiq 'digest.*:[[:space:]]*OK[[:space:]]*$' "$work/empty-rpmkeys.log"
    if grep -Eiq 'signature.*:[[:space:]]*OK[[:space:]]*$' "$work/empty-rpmkeys.log"; then
        exit 1
    fi
    echo 'INT_FEED_CHECK:empty-rpm-rejected:PASS'
    rpmkeys --dbpath "$db" --import "$work/trusted.asc"
    test "$(rpm --dbpath "$db" -qa --qf '%{NAME}\n')" = gpg-pubkey
    rpmkeys --dbpath "$db" --define '_pkgverify_level all' --checksig --verbose \
        "$package" > "$work/imported-rpmkeys.log" 2>&1
    cat "$work/imported-rpmkeys.log"
    grep -Eiq 'signature.*:[[:space:]]*OK[[:space:]]*$' "$work/imported-rpmkeys.log"
    grep -Eiq 'digest.*:[[:space:]]*OK[[:space:]]*$' "$work/imported-rpmkeys.log"
    if grep -Eiq '(NOKEY|NOTFOUND|BAD|NOT OK|without OpenPGP)' "$work/imported-rpmkeys.log"; then
        exit 1
    fi
    echo 'INT_FEED_CHECK:imported-rpm-accepted:PASS'
    check_version 1.0
    echo 'INT_FEED_CHECK:unchanged-v1:PASS'
    echo 'INT_FEED_CASE:empty-rpm-trust:PASS'
    result=PASS
    exit 0
fi
if test "$test_case" = unsigned-rpm; then
    # Validate the signed metadata and make sure it advertises exactly the
    # intended version before trying a transaction. A missing package, stale
    # metadata or unrelated DNF error must never count as signature rejection.
    dnf -c "$work/dnf.conf" --disablerepo='*' --enablerepo=intfeed-unsigned --refresh makecache
    candidate=$(dnf -q -c "$work/dnf.conf" --disablerepo='*' --enablerepo=intfeed-unsigned \
        repoquery --available --qf '%{name} %{version} %{release}' int-feed-probe)
    test "$candidate" = 'int-feed-probe 2.0 r0'
    echo 'INT_FEED_CHECK:unsigned-metadata:PASS'

    package="$work/mount/unsigned-rpm/int-feed-probe-2.0-r0.noarch.rpm"
    if rpmkeys --define '_pkgverify_level all' --checksig --verbose "$package" > "$work/rpmkeys.log" 2>&1; then
        echo 'Unsigned package unexpectedly passed strict RPM verification' >&2
        exit 1
    fi
    cat "$work/rpmkeys.log"
    grep -Eiq 'signature.*:[[:space:]]*NOTFOUND[[:space:]]*$' "$work/rpmkeys.log"
    grep -Eiq 'digest.*:[[:space:]]*OK[[:space:]]*$' "$work/rpmkeys.log"
    if grep -Eiq 'signature.*:[[:space:]]*OK[[:space:]]*$' "$work/rpmkeys.log"; then
        echo 'Unexpected successful signature on unsigned package' >&2
        exit 1
    fi
    echo 'INT_FEED_CHECK:unsigned-rpmkeys:PASS'

    if dnf -c "$work/dnf.conf" --disablerepo='*' --enablerepo=intfeed-unsigned \
        upgrade int-feed-probe > "$work/unsigned-dnf.log" 2>&1; then
        echo 'DNF unexpectedly accepted unsigned upgrade' >&2
        exit 1
    else
        dnf_status=$?
    fi
    cat "$work/unsigned-dnf.log"
    test "$dnf_status" -ne 0
    grep -Fq 'Package int-feed-probe-2.0-r0.noarch.rpm is not signed' "$work/unsigned-dnf.log"
    grep -Fq 'GPG check FAILED' "$work/unsigned-dnf.log"
    echo 'INT_FEED_CHECK:unsigned-dnf-rejected:PASS'
    check_version 1.0
    echo 'INT_FEED_CHECK:unchanged-v1:PASS'
    echo 'INT_FEED_CASE:unsigned-rpm:PASS'
    result=PASS
    exit 0
fi
if test "$test_case" = wrong-key-rpm; then
    # The metadata is signed by the pinned key, but the package is signed by
    # a different, untrusted key. Resolve version 2 before testing rejection.
    dnf -c "$work/dnf.conf" --disablerepo='*' --enablerepo=intfeed-wrong-key --refresh makecache
    candidate=$(dnf -q -c "$work/dnf.conf" --disablerepo='*' --enablerepo=intfeed-wrong-key \
        repoquery --available --qf '%{name} %{version} %{release}' int-feed-probe)
    test "$candidate" = 'int-feed-probe 2.0 r0'
    echo 'INT_FEED_CHECK:wrong-key-metadata:PASS'

    # Establish that this target RPM backend can verify a package signed by
    # the pinned key before attributing the next failure to missing trust.
    trusted="$work/mount/valid-v2/int-feed-probe-2.0-r0.noarch.rpm"
    rpmkeys --define '_pkgverify_level all' --checksig --verbose "$trusted" > "$work/trusted-rpmkeys.log" 2>&1
    cat "$work/trusted-rpmkeys.log"
    grep -Eiq 'signature.*:[[:space:]]*OK[[:space:]]*$' "$work/trusted-rpmkeys.log"
    grep -Eiq 'digest.*:[[:space:]]*OK[[:space:]]*$' "$work/trusted-rpmkeys.log"
    echo 'INT_FEED_CHECK:trusted-rpmkeys:PASS'

    package="$work/mount/wrong-key-rpm/int-feed-probe-2.0-r0.noarch.rpm"
    if rpmkeys --define '_pkgverify_level all' --checksig --verbose "$package" > "$work/wrong-key-rpmkeys.log" 2>&1; then
        echo 'Wrong-key package unexpectedly passed strict RPM verification' >&2
        exit 1
    fi
    cat "$work/wrong-key-rpmkeys.log"
    grep -Eiq 'signature.*:[[:space:]]*NOKEY[[:space:]]*$' "$work/wrong-key-rpmkeys.log"
    grep -Eiq 'digest.*:[[:space:]]*OK[[:space:]]*$' "$work/wrong-key-rpmkeys.log"
    if grep -Eiq 'signature.*:[[:space:]]*OK[[:space:]]*$' "$work/wrong-key-rpmkeys.log"; then
        echo 'Unexpected trusted signature on wrong-key package' >&2
        exit 1
    fi
    echo 'INT_FEED_CHECK:wrong-key-rpmkeys:PASS'

    if dnf -c "$work/dnf.conf" --disablerepo='*' --enablerepo=intfeed-wrong-key \
        upgrade int-feed-probe > "$work/wrong-key-dnf.log" 2>&1; then
        echo 'DNF unexpectedly accepted wrong-key upgrade' >&2
        exit 1
    else
        dnf_status=$?
    fi
    cat "$work/wrong-key-dnf.log"
    test "$dnf_status" -ne 0
    grep -Fq 'already installed but they are not correct for this package' "$work/wrong-key-dnf.log"
    grep -Fq 'GPG check FAILED' "$work/wrong-key-dnf.log"
    echo 'INT_FEED_CHECK:wrong-key-dnf-rejected:PASS'
    check_version 1.0
    echo 'INT_FEED_CHECK:unchanged-v1:PASS'
    echo 'INT_FEED_CASE:wrong-key-rpm:PASS'
    result=PASS
    exit 0
fi
if test "$test_case" = altered-primary; then
    # A signed repomd references primary metadata changed after signing.
    # Confirm the untouched repository first in this fresh guest.
    dnf -c "$work/dnf.conf" --disablerepo='*' --enablerepo=intfeed-v2 --refresh makecache
    candidate=$(dnf -q -c "$work/dnf.conf" --disablerepo='*' --enablerepo=intfeed-v2 \
        repoquery --available --qf '%{name} %{version} %{release}' int-feed-probe)
    test "$candidate" = 'int-feed-probe 2.0 r0'
    echo 'INT_FEED_CHECK:primary-metadata:PASS'
    stale="$work/mount/altered-primary"
    valid="$work/mount/valid-v2"
    gpg --batch --no-options --homedir "$work/home" --import "$work/trusted.asc" > "$work/gpg-import.log" 2>&1
    gpg --batch --no-options --homedir "$work/home" --status-fd 1 --verify \
        "$stale/repodata/repomd.xml.asc" "$stale/repodata/repomd.xml" > "$work/primary-signature.log" 2>&1
    cat "$work/primary-signature.log"
    grep -Fq "[GNUPG:] VALIDSIG $fingerprint " "$work/primary-signature.log"
    # Signed repomd is identical; the referenced primary file must differ.
    cmp "$valid/repodata/repomd.xml" "$stale/repodata/repomd.xml"
    set -- "$stale"/repodata/*-primary.xml.gz
    test "$#" -eq 1 && test -s "$1"
    primary_name=${1##*/}
    test -s "$valid/repodata/$primary_name"
    good_hash=$(sha256sum "$valid/repodata/$primary_name"); good_hash=${good_hash%% *}
    bad_hash=$(sha256sum "$1"); bad_hash=${bad_hash%% *}
    test "$good_hash" != "$bad_hash"
    echo 'INT_FEED_CHECK:primary-fixture:PASS'
    if dnf -c "$work/dnf.conf" --disablerepo='*' --enablerepo=intfeed-primary \
        --refresh makecache > "$work/primary-dnf.log" 2>&1; then
        echo 'DNF unexpectedly accepted mismatching primary metadata' >&2
        exit 1
    else
        dnf_status=$?
    fi
    cat "$work/primary-dnf.log"
    test "$dnf_status" -ne 0
    grep -Fq "Downloading successful, but checksum doesn't match." "$work/primary-dnf.log"
    grep -Fq 'primary.xml.gz' "$work/primary-dnf.log"
    grep -Fq "Failed to download metadata for repo 'intfeed-primary'" "$work/primary-dnf.log"
    echo 'INT_FEED_CHECK:primary-dnf-rejected:PASS'
    check_version 1.0
    echo 'INT_FEED_CHECK:unchanged-v1:PASS'
    echo 'INT_FEED_CASE:altered-primary:PASS'
    result=PASS
    exit 0
fi
if test "$test_case" = stale-rpm-checksum; then
    # This repository has authentic metadata but package bytes changed after
    # indexing. A fresh cache ensures DNF cannot reuse the valid counterpart.
    dnf -c "$work/dnf.conf" --disablerepo='*' --enablerepo=intfeed-stale --refresh makecache
    candidate=$(dnf -q -c "$work/dnf.conf" --disablerepo='*' --enablerepo=intfeed-stale \
        repoquery --available --qf '%{name} %{version} %{release}' int-feed-probe)
    test "$candidate" = 'int-feed-probe 2.0 r0'
    echo 'INT_FEED_CHECK:stale-metadata:PASS'
    stale="$work/mount/stale-rpm-checksum"
    valid="$work/mount/valid-v2"
    gpg --batch --no-options --homedir "$work/home" --import "$work/trusted.asc" > "$work/gpg-import.log" 2>&1
    gpg --batch --no-options --homedir "$work/home" --status-fd 1 --verify \
        "$stale/repodata/repomd.xml.asc" "$stale/repodata/repomd.xml" > "$work/stale-signature.log" 2>&1
    cat "$work/stale-signature.log"
    grep -Fq "[GNUPG:] VALIDSIG $fingerprint " "$work/stale-signature.log"
    # The signed index was copied from valid-v2, while only RPM bytes changed.
    cmp "$valid/repodata/repomd.xml" "$stale/repodata/repomd.xml"
    package=int-feed-probe-2.0-r0.noarch.rpm
    test -s "$stale/$package"
    good_hash=$(sha256sum "$valid/$package"); good_hash=${good_hash%% *}
    bad_hash=$(sha256sum "$stale/$package"); bad_hash=${bad_hash%% *}
    test "$good_hash" != "$bad_hash"
    echo 'INT_FEED_CHECK:stale-fixture:PASS'
    if dnf -c "$work/dnf.conf" --disablerepo='*' --enablerepo=intfeed-stale \
        upgrade int-feed-probe > "$work/stale-dnf.log" 2>&1; then
        echo 'DNF unexpectedly accepted a mismatching package checksum' >&2
        exit 1
    else
        dnf_status=$?
    fi
    cat "$work/stale-dnf.log"
    test "$dnf_status" -ne 0
    grep -Fq 'Package "int-feed-probe-2.0-r0.noarch" from local repository "intfeed-stale" has incorrect checksum' "$work/stale-dnf.log"
    grep -Fq 'Some packages from local repository have incorrect checksum' "$work/stale-dnf.log"
    echo 'INT_FEED_CHECK:stale-dnf-rejected:PASS'
    check_version 1.0
    echo 'INT_FEED_CHECK:unchanged-v1:PASS'
    echo 'INT_FEED_CASE:stale-rpm-checksum:PASS'
    result=PASS
    exit 0
fi
if test "$test_case" = corrupt-rpm-indexed; then
    # Freshly signed metadata indexes a package with a deliberately damaged
    # payload. Resolve version 2 before testing its digest rejection.
    dnf -c "$work/dnf.conf" --disablerepo='*' --enablerepo=intfeed-corrupt --refresh makecache
    candidate=$(dnf -q -c "$work/dnf.conf" --disablerepo='*' --enablerepo=intfeed-corrupt \
        repoquery --available --qf '%{name} %{version} %{release}' int-feed-probe)
    test "$candidate" = 'int-feed-probe 2.0 r0'
    echo 'INT_FEED_CHECK:corrupt-metadata:PASS'

    # Establish that this target RPM backend can verify a package signed by
    # the pinned key before attributing the next failure to payload corruption.
    trusted="$work/mount/valid-v2/int-feed-probe-2.0-r0.noarch.rpm"
    rpmkeys --define '_pkgverify_level all' --checksig --verbose "$trusted" > "$work/trusted-rpmkeys.log" 2>&1
    cat "$work/trusted-rpmkeys.log"
    grep -Eiq 'signature.*:[[:space:]]*OK[[:space:]]*$' "$work/trusted-rpmkeys.log"
    grep -Eiq 'digest.*:[[:space:]]*OK[[:space:]]*$' "$work/trusted-rpmkeys.log"
    echo 'INT_FEED_CHECK:trusted-rpmkeys:PASS'

    package="$work/mount/corrupt-rpm-indexed/int-feed-probe-2.0-r0.noarch.rpm"
    if rpmkeys --define '_pkgverify_level all' --checksig --verbose "$package" > "$work/corrupt-rpmkeys.log" 2>&1; then
        echo 'Corrupt package unexpectedly passed strict RPM verification' >&2
        exit 1
    fi
    cat "$work/corrupt-rpmkeys.log"
    grep -Eiq 'digest.*:[[:space:]]*BAD([[:space:]]|$)' "$work/corrupt-rpmkeys.log"
    grep -Eiq 'digest.*:[[:space:]]*OK[[:space:]]*$' "$work/corrupt-rpmkeys.log"
    echo 'INT_FEED_CHECK:corrupt-rpmkeys:PASS'

    if dnf -c "$work/dnf.conf" --disablerepo='*' --enablerepo=intfeed-corrupt \
        upgrade int-feed-probe > "$work/corrupt-dnf.log" 2>&1; then
        echo 'DNF unexpectedly accepted corrupt upgrade' >&2
        exit 1
    else
        dnf_status=$?
    fi
    cat "$work/corrupt-dnf.log"
    test "$dnf_status" -ne 0
    grep -Fq 'Problem opening package int-feed-probe-2.0-r0.noarch.rpm' "$work/corrupt-dnf.log"
    grep -Fq 'GPG check FAILED' "$work/corrupt-dnf.log"
    echo 'INT_FEED_CHECK:corrupt-dnf-rejected:PASS'
    check_version 1.0
    echo 'INT_FEED_CHECK:unchanged-v1:PASS'
    echo 'INT_FEED_CASE:corrupt-rpm-indexed:PASS'
    result=PASS
    exit 0
fi
if test "$test_case" = missing-metadata-signature; then
    # Confirm the equivalent signed repository works before testing its copy
    # with the detached signature deliberately omitted.
    dnf -c "$work/dnf.conf" --disablerepo='*' --enablerepo=intfeed-v2 --refresh makecache
    candidate=$(dnf -q -c "$work/dnf.conf" --disablerepo='*' --enablerepo=intfeed-v2 \
        repoquery --available --qf '%{name} %{version} %{release}' int-feed-probe)
    test "$candidate" = 'int-feed-probe 2.0 r0'
    check_version 1.0
    echo 'INT_FEED_CHECK:signed-metadata-control:PASS'

    missing="$work/mount/missing-metadata-signature"
    valid="$work/mount/valid-v2"
    test -s "$missing/repodata/repomd.xml"
    test ! -e "$missing/repodata/repomd.xml.asc"
    test -s "$missing/int-feed-probe-2.0-r0.noarch.rpm"
    test -s "$valid/repodata/repomd.xml.asc"
    # The detached signature from the valid feed must authenticate the
    # candidate repomd with the independently pinned public key. DNF is not
    # given this signature for the missing-signature repository.
    gpg --batch --no-options --homedir "$work/home" --import "$work/trusted.asc" > "$work/gpg-import.log" 2>&1
    gpg --batch --no-options --homedir "$work/home" --status-fd 1 --verify \
        "$valid/repodata/repomd.xml.asc" "$missing/repodata/repomd.xml" > "$work/missing-control.log" 2>&1
    cat "$work/missing-control.log"
    grep -Fq "[GNUPG:] VALIDSIG $fingerprint " "$work/missing-control.log"
    echo 'INT_FEED_CHECK:missing-signature-fixture:PASS'

    # Keep this repository's cache and metadata trust separate from both
    # successful control repositories, and fail instead of skipping it.
    mkdir -m 0700 "$work/cache-missing" "$work/persist-missing"
    cat > "$work/dnf-missing.conf" <<EOF
[main]
reposdir=$work/repos
cachedir=$work/cache-missing
persistdir=$work/persist-missing
plugins=0
gpgcheck=1
localpkg_gpgcheck=1
assumeyes=1
EOF
    if dnf -c "$work/dnf-missing.conf" --disablerepo='*' --enablerepo=intfeed-missing-signature \
        --refresh makecache > "$work/missing-dnf.log" 2>&1; then
        echo 'DNF unexpectedly accepted metadata without a signature' >&2
        exit 1
    else
        dnf_status=$?
    fi
    cat "$work/missing-dnf.log"
    test "$dnf_status" -ne 0
    grep -Fq 'GPG verification is enabled, but GPG signature is not available' "$work/missing-dnf.log"
    grep -Fq '/missing-metadata-signature/repodata/repomd.xml.asc' "$work/missing-dnf.log"
    echo 'INT_FEED_CHECK:missing-signature-rejected:PASS'
    check_version 1.0
    echo 'INT_FEED_CHECK:unchanged-v1:PASS'
    echo 'INT_FEED_CASE:missing-metadata-signature:PASS'
    result=PASS
    exit 0
fi
if test "$test_case" = wrong-key-metadata; then
    # Positive control before testing an untrusted metadata signing key.
    dnf -c "$work/dnf.conf" --disablerepo='*' --enablerepo=intfeed-v2 --refresh makecache
    candidate=$(dnf -q -c "$work/dnf.conf" --disablerepo='*' --enablerepo=intfeed-v2 \
        repoquery --available --qf '%{name} %{version} %{release}' int-feed-probe)
    test "$candidate" = 'int-feed-probe 2.0 r0'
    check_version 1.0
    echo 'INT_FEED_CHECK:signed-metadata-control:PASS'

    altered="$work/mount/wrong-key-metadata"
    valid="$work/mount/valid-v2"
    signature="$altered/repodata/repomd.xml.asc"
    test -s "$signature"
    test -s "$altered/repodata/repomd.xml"
    test -s "$altered/int-feed-probe-2.0-r0.noarch.rpm"
    test -s "$valid/repodata/repomd.xml"
    gpg --batch --no-options --homedir "$work/home" --import "$work/trusted.asc" > "$work/gpg-import.log" 2>&1
