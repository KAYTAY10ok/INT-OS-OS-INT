[Unit]
Description=Choose the first INT owner on the local console
After=local-fs.target systemd-user-sessions.service
Before=getty.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/int-firstboot
RemainAfterExit=yes
StandardInput=tty-force
StandardOutput=tty
StandardError=tty
TTYPath=/dev/console
TTYReset=yes
TimeoutStartSec=infinity
UMask=0077

[Install]
WantedBy=multi-user.target
