#!/usr/bin/env python3
"""int-ai-model: choose, download, verify and serve the local AI model.

Models are Qwen2.5 Instruct GGUF files (Q4_K_M) fetched from huggingface.co
at a pinned repository revision and checked against pinned SHA-256 values.
A model is used only after its hash matches; `serve` re-checks it every time
before starting llama-server on 127.0.0.1.
"""
import argparse
import hashlib
import json
import os
import stat
import subprocess
import sys
import urllib.request

STATE_DIR = "/var/lib/int-ai"
MODELS_DIR = STATE_DIR + "/models"
SELECTION = STATE_DIR + "/model.json"
INSTALL_CONF = "/etc/int/install.conf"
LLAMA_SERVER = "/usr/bin/llama-server"
SERVICE = "int-ai.service"
PORT = 8765
GIB = 1024 ** 3

# Sizes, pinned revisions and hashes come from the Hugging Face repository
# metadata (LFS SHA-256). The 7B Q4_K_M model is published in two parts;
# llama-server loads the second part from the first one's directory.
MODELS = {
    "1.5b": {
        "repo": "Qwen/Qwen2.5-1.5B-Instruct-GGUF",
        "revision": "91cad51170dc346986eccefdc2dd33a9da36ead9",
        "license": "Apache-2.0",
        "needs_acceptance": False,
        "min_ram": 4 * GIB,
        "files": [
            ("qwen2.5-1.5b-instruct-q4_k_m.gguf",
             "6a1a2eb6d15622bf3c96857206351ba97e1af16c30d7a74ee38970e434e9407e", 1117320736),
        ],
    },
    "3b": {
        "repo": "Qwen/Qwen2.5-3B-Instruct-GGUF",
        "revision": "7dabda4d13d513e3e842b20f0d435c732f172cbe",
        # Not Apache-2.0: non-commercial research licence, explicit acceptance required.
        "license": "Qwen-Research-License",
        "needs_acceptance": True,
        "min_ram": 6 * GIB,
        "files": [
            ("qwen2.5-3b-instruct-q4_k_m.gguf",
             "626b4a6678b86442240e33df819e00132d3ba7dddfe1cdc4fbb18e0a9615c62d", 2104932768),
        ],
    },
    "7b": {
        "repo": "Qwen/Qwen2.5-7B-Instruct-GGUF",
        "revision": "bb5d59e06d9551d752d08b292a50eb208b07ab1f",
        "license": "Apache-2.0",
        "needs_acceptance": False,
        "min_ram": 16 * GIB,
        "files": [
            ("qwen2.5-7b-instruct-q4_k_m-00001-of-00002.gguf",
             "dfce12e3862a5283ccfb88221b48480e58745165de856439950d0f22590580db", 3993201344),
            ("qwen2.5-7b-instruct-q4_k_m-00002-of-00002.gguf",
             "539cf93f78e887edea1c04e2d7d8cdaca9d01dae9c9025bcb8accbe29df3d72a", 689872288),
        ],
    },
}
ACCEPT_TOKEN = "qwen-research"


def err(text):
    print("int-ai-model: " + text, file=sys.stderr)


def file_url(size, name):
    entry = MODELS[size]
    return "https://huggingface.co/%s/resolve/%s/%s" % (entry["repo"], entry["revision"], name)


def total_ram(meminfo="/proc/meminfo"):
    try:
        with open(meminfo, encoding="utf-8") as handle:
            for line in handle:
                if line.startswith("MemTotal:"):
                    return int(line.split()[1]) * 1024
    except (OSError, ValueError, IndexError):
        pass
    return 0


def recommend(ram):
    """Size suggested for this RAM. The research-licensed 3B is never auto-suggested."""
    if ram >= MODELS["7b"]["min_ram"]:
        return "7b"
    if ram >= MODELS["1.5b"]["min_ram"]:
        return "1.5b"
    return "none"


def verify_file(path, digest, length):
    """True only for a regular, non-symlink file with the pinned size and SHA-256."""
    try:
        st = os.lstat(path)
    except OSError:
        return False
    if not stat.S_ISREG(st.st_mode) or st.st_size != length:
        return False
    sha = hashlib.sha256()
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
        with os.fdopen(fd, "rb") as handle:
            for block in iter(lambda: handle.read(1 << 20), b""):
                sha.update(block)
    except OSError:
        return False
    return sha.hexdigest() == digest


def download(url, dest, digest, length, opener=None):
    """Download to dest.part, check size and SHA-256, then rename into place."""
    part = dest + ".part"
    sha = hashlib.sha256()
    received = 0
    opener = opener or urllib.request.build_opener()
    request = urllib.request.Request(url, headers={"User-Agent": "int-ai-model"})
    fd = os.open(part, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o644)
    try:
        with os.fdopen(fd, "wb") as handle, opener.open(request, timeout=60) as response:
            while True:
                block = response.read(1 << 20)
                if not block:
                    break
                received += len(block)
                if received > length:
                    raise ValueError("download larger than expected")
                sha.update(block)
                handle.write(block)
                if received % (256 << 20) < len(block):
                    print("  %d / %d MiB" % (received >> 20, length >> 20), flush=True)
        if received != length or sha.hexdigest() != digest:
            raise ValueError("size or SHA-256 mismatch")
        os.replace(part, dest)
    except BaseException:
        try:
            os.unlink(part)
        except OSError:
            pass
        raise


def read_selection(path=SELECTION):
    try:
        with open(path, encoding="utf-8") as handle:
            data = json.load(handle)
    except (OSError, ValueError):
        return None
    size = data.get("size") if isinstance(data, dict) else None
    return size if size in MODELS else None


def model_paths(size, models_dir=MODELS_DIR):
    return [(os.path.join(models_dir, name), digest, length) for name, digest, length in MODELS[size]["files"]]


def verify_size(size, models_dir=MODELS_DIR):
    return all(verify_file(path, digest, length) for path, digest, length in model_paths(size, models_dir))


def run_argv(argv):
    return subprocess.run(argv, shell=False, check=False, stdin=subprocess.DEVNULL).returncode


def server_argv(model_path, threads=None):
    threads = threads or max(1, min(8, (os.cpu_count() or 2) - 1))
    return [LLAMA_SERVER, "--model", model_path, "--host", "127.0.0.1", "--port", str(PORT),
            "--ctx-size", "4096", "--parallel", "1", "--threads", str(threads), "--no-webui", "--offline"]


def require_root():
    if os.geteuid() != 0:
        err("root is required (sudo)")
        return False
    return True


def cmd_install(size, accept=None, enable=False, models_dir=MODELS_DIR, selection=SELECTION):
    entry = MODELS[size]
    if entry["needs_acceptance"] and accept != ACCEPT_TOKEN:
        err("the %s model is under the %s (non-commercial research use only), not Apache-2.0; "
            "rerun with --accept-licence %s to accept it" % (size, entry["license"], ACCEPT_TOKEN))
        return 2
    if not require_root():
        return 2
    os.makedirs(models_dir, mode=0o755, exist_ok=True)
    for path, digest, length in model_paths(size, models_dir):
        if verify_file(path, digest, length):
            print("ok  " + os.path.basename(path))
            continue
        print("get " + os.path.basename(path), flush=True)
        try:
            download(file_url(size, os.path.basename(path)), path, digest, length)
        except (OSError, ValueError) as exc:
            err("download failed for %s: %s" % (os.path.basename(path), exc))
            return 1
    if not verify_size(size, models_dir):
        err("verification failed")
        return 1
    tmp = selection + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o644)
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        json.dump({"size": size, "license": entry["license"]}, handle)
    os.replace(tmp, selection)
    print("model %s installed and verified" % size)
    if enable:
        return 1 if run_argv(["systemctl", "enable", "--now", SERVICE]) else 0
    return 0


def cmd_remove(models_dir=MODELS_DIR, selection=SELECTION):
    if not require_root():
        return 2
    if not sys.stdin.isatty():
        err("confirmation needs a terminal")
        return 3
    answer = input("Remove the local AI model and disable %s? [y/N] " % SERVICE)
    if answer.strip().lower() not in ("y", "yes", "o", "oui"):
        return 3
    run_argv(["systemctl", "disable", "--now", SERVICE])
    for size in MODELS:
        for path, _digest, _length in model_paths(size, models_dir):
            for candidate in (path, path + ".part"):
                if os.path.lexists(candidate):
                    os.unlink(candidate)
    if os.path.lexists(selection):
        os.unlink(selection)
    print("removed")
    return 0


def cmd_serve():
    size = read_selection()
    if size is None:
        err("no model selected; run: sudo int-ai-model install SIZE")
        return 1
    if not verify_size(size):
        err("model files missing or SHA-256 mismatch; refusing to start")
        return 1
    argv = server_argv(model_paths(size)[0][0])
    if not os.path.isfile(LLAMA_SERVER):
        err("%s is not installed" % LLAMA_SERVER)
        return 1
    os.execv(argv[0], argv)
    return 1


def read_install_conf(path=INSTALL_CONF):
    values = {}
    try:
        with open(path, encoding="utf-8") as handle:
            for line in handle:
                key, sep, value = line.strip().partition("=")
                if sep and key.startswith("INT_AI_"):
                    values[key] = value.strip().strip("'\"")
    except OSError:
        pass
    return values


def cmd_firstboot(conf=INSTALL_CONF, done=STATE_DIR + "/setup-done"):
    """Install the model chosen at installation, if any, then enable the service."""
    values = read_install_conf(conf)
    size = values.get("INT_AI_MODEL", "none").lower()
    if size in ("", "none"):
        code = 0
    elif size not in MODELS:
        err("unknown INT_AI_MODEL=%s" % size)
        code = 0
    else:
        code = cmd_install(size, accept=values.get("INT_AI_ACCEPT_LICENCE"), enable=True)
    if code in (0, 2):  # done, or permanently refused (e.g. licence not accepted)
        os.makedirs(os.path.dirname(done), mode=0o755, exist_ok=True)
        with open(done, "w", encoding="utf-8") as handle:
            handle.write(size + "\n")
    return code


def cmd_list():
    selected = read_selection()
    ram = total_ram()
    print("RAM %.1f GiB, suggested: %s" % (ram / GIB, recommend(ram)))
    for size, entry in MODELS.items():
        total = sum(f[2] for f in entry["files"])
        mark = "*" if size == selected else " "
        print("%s %-5s %5.1f GiB  min RAM %2d GiB  %s" % (mark, size, total / GIB, entry["min_ram"] // GIB,
                                                       entry["license"]))
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(prog="int-ai-model", description="Manage the INT local AI model.")
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("list", help="show sizes, licences and the installed model")
    rec = sub.add_parser("recommend", help="print the size suggested for this machine's RAM")
    rec.add_argument("--ram", type=int, help="RAM in bytes instead of /proc/meminfo")
    inst = sub.add_parser("install", help="download and verify a model (root)")
    inst.add_argument("size", choices=sorted(MODELS))
    inst.add_argument("--accept-licence", dest="accept", metavar="NAME")
    inst.add_argument("--enable", action="store_true", help="enable and start %s afterwards" % SERVICE)
    sub.add_parser("verify", help="check the installed model against its pinned SHA-256")
    sub.add_parser("remove", help="delete the model and disable the service (root, confirmed)")
    sub.add_parser("serve", help="verify then run llama-server on 127.0.0.1 (used by %s)" % SERVICE)
    sub.add_parser("firstboot", help="install the model chosen at installation (used by int-ai-setup.service)")
    opts = parser.parse_args(argv)

    if opts.command == "list":
        return cmd_list()
    if opts.command == "recommend":
        print(recommend(opts.ram if opts.ram is not None else total_ram()))
        return 0
    if opts.command == "install":
        return cmd_install(opts.size, accept=opts.accept, enable=opts.enable)
    if opts.command == "verify":
        size = read_selection()
        if size is None:
            err("no model installed")
            return 1
        good = verify_size(size)
        print("%s: %s" % (size, "ok" if good else "FAILED"))
        return 0 if good else 1
    if opts.command == "remove":
        return cmd_remove()
    if opts.command == "serve":
        return cmd_serve()
    if opts.command == "firstboot":
        return cmd_firstboot()
    return 2


if __name__ == "__main__":
    sys.exit(main())
