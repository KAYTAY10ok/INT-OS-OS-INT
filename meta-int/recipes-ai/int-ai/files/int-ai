# Canonical theme names (the int-theme presets). The model may only choose one
# of these; French or English synonyms from the offline rules map onto them.
THEMES = ("dark", "light", "blue", "pink", "anime")
# Application presets of int-apps (/usr/share/int/apps/*.preset).
APP_PRESETS = ("cyber", "opsec", "terminal", "desktop-tools", "dev", "web", "audio", "multimedia")
# Paths given by the model must be written relative to the home with "~/".
MODEL_PATH_PATTERN = r"^~/[^\x00]{1,%d}$" % (MAX_PATH - 2)


def _model_args(name, args):
    """Tighten an action's arguments for constrained decoding only."""
    props = dict(args.get("properties", {}))
    if name == "theme.set":
        props["name"] = {"type": "string", "enum": list(THEMES)}
    if name in ("apps.add", "apps.remove"):
        props["name"] = {"type": "string", "enum": list(APP_PRESETS)}
    for key in ("path",):
        if key in props:
            props[key] = {"type": "string", "pattern": MODEL_PATH_PATTERN, "maxLength": MAX_PATH}
    return dict(args, properties=props)


def action_schema():
    """JSON schema given to llama-server: exactly one registry action."""
    variants = []
    for name, (args, _policy, _desc) in REGISTRY.items():
        args = _model_args(name, args)
        variants.append({
            "type": "object",
            "properties": {"action": {"const": name}, "args": args},
            "required": ["action", "args"],
            "additionalProperties": False,
        })
    return {"oneOf": variants}


# ---------------------------------------------------------------- messages

def detect_language(environ=None, conf_path=INSTALL_CONF):
    environ = os.environ if environ is None else environ
    value = environ.get("INT_AI_LANG", "")
    if not value:
        try:
            with open(conf_path, encoding="utf-8") as conf:
                for line in conf:
                    if line.startswith("INT_LANGUAGE="):
                        value = line.split("=", 1)[1].strip().strip("'\"")
        except OSError:
            pass
    if not value:
        value = environ.get("LC_ALL") or environ.get("LC_MESSAGES") or environ.get("LANG") or ""
    return "fr" if value.lower().startswith("fr") else "en"


