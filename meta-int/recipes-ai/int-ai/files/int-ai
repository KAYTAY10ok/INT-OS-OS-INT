# Destructive intents have no action in the registry. Refuse them before any
# model call: a small model may otherwise map them to an unrelated action.
DESTRUCTIVE = re.compile(
    r"\b(?:supprim\w*|effac\w*|d[ée]trui\w*|formate\w*|vid(?:e|er|ez)\b|écrase\w*|ecrase\w*|"
    r"d[ée]sinstall\w*|delete\w*|remove\w*|erase\w*|wipe\w*|destroy\w*|format\b|uninstall\w*|"
    r"rm\b|shred\w*|kill\w*)",
    re.IGNORECASE)


def is_destructive(text):
    return DESTRUCTIVE.search(text) is not None


def parse_rules(text):
    """Deterministic offline parser. Returns an unvalidated action or None."""
    text = " ".join(text.strip().split())
    text = text.rstrip(" .!?")
    text = re.sub(r"^(?:int-ai[:,]?\s+)?(?:(?:s'il\s+te\s+pla[iî]t|stp|svp|please)[,]?\s+)?", "", text,
                  flags=re.IGNORECASE)
    text = re.sub(r"\s*,?\s*(?:s'il\s+te\s+pla[iî]t|stp|svp|please)$", "", text, flags=re.IGNORECASE)
    for regex, build in RULES:
        match = regex.fullmatch(text)
        if match:
            return build(match)
    return None


