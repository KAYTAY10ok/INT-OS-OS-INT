# ---------------------------------------------------------------- validation

class Invalid(Exception):
    pass


def _check(value, schema, where):
    kind = schema.get("type")
    if kind == "object":
        if not isinstance(value, dict):
            raise Invalid(where + ": object expected")
        props = schema.get("properties", {})
        for key in value:
            if not isinstance(key, str) or key not in props:
                raise Invalid("%s: unexpected field %r" % (where, key))
        for key in schema.get("required", []):
            if key not in value:
                raise Invalid("%s: missing field %r" % (where, key))
        for key, sub in props.items():
            if key in value:
                _check(value[key], sub, where + "." + key)
    elif kind == "string":
        if not isinstance(value, str):
            raise Invalid(where + ": string expected")
        if "\x00" in value:
            raise Invalid(where + ": NUL character")
        if len(value) < schema.get("minLength", 0):
            raise Invalid(where + ": too short")
        if len(value) > schema.get("maxLength", 1 << 30):
            raise Invalid(where + ": too long")
        if "pattern" in schema and not re.fullmatch(schema["pattern"].strip("^$"), value):
            raise Invalid(where + ": invalid value")
    else:
        raise Invalid(where + ": unsupported schema")


def validate(candidate):
    """Return a clean {"action", "args"} dict or raise Invalid."""
    if isinstance(candidate, (str, bytes)):
        if len(candidate) > MAX_CONTENT * 2:
            raise Invalid("action too large")
        try:
            candidate = json.loads(candidate)
        except (ValueError, UnicodeDecodeError) as exc:
            raise Invalid("not JSON: %s" % exc) from None
    if not isinstance(candidate, dict):
        raise Invalid("action must be a JSON object")
    if set(candidate) != {"action", "args"}:
        raise Invalid("action must have exactly the fields 'action' and 'args'")
    name = candidate["action"]
    if not isinstance(name, str) or name not in REGISTRY:
        raise Invalid("unknown action %r" % (name,))
    _check(candidate["args"], REGISTRY[name][0], name)
    args = dict(candidate["args"])
    if name == "theme.set":
        # Map French/English synonyms (e.g. "rose") onto the canonical preset name.
        args["name"] = THEME_WORDS.get(args["name"], args["name"])
    return {"action": name, "args": args}


def policy_of(action):
    return REGISTRY[action["action"]][1]


