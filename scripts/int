#!/usr/bin/env python3
"""Build the first INT image without modifying upstream sources or host trust."""
import argparse
from contextlib import contextmanager
import fcntl
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import shutil

REPO = Path(__file__).resolve().parents[1]
LOCK = json.loads((REPO / "configs/sources.lock.json").read_text())
IMAGE = "int-linux-builder:wrynose-1"


def run(args, **kwargs):
    print("+", " ".join(map(str, args)), flush=True)
    return subprocess.run(list(map(str, args)), check=True, **kwargs)


def docker(args, **kwargs):
    env = os.environ.copy()
    for name in ("DOCKER_HOST", "DOCKER_CONTEXT", "DOCKER_TLS", "DOCKER_TLS_VERIFY", "DOCKER_CERT_PATH"):
        env.pop(name, None)
    return run(["docker", "--host=unix:///var/run/docker.sock", *args], env=env, **kwargs)


def network_args():
    """Optional host networking for hosts whose HTTPS proxy listens on loopback.

    Only the exact value "host" is accepted. No port is published either way.
    """
    mode = os.environ.get("INT_DOCKER_NETWORK", "")
    if mode == "":
        return []
    if mode != "host":
        raise RuntimeError('INT_DOCKER_NETWORK accepts only "host"')
    return ["--network", "host"]


def workdir():
    path = Path(os.environ.get("INT_WORKDIR", REPO.parent / "int-linux-work")).resolve()
    if path == REPO or REPO in path.parents or path == Path("/"):
        raise RuntimeError("INT_WORKDIR must be outside the checkout and cannot be /")
    return path


@contextmanager
def operation_lock(work):
    """Keep build metadata, source changes and image snapshots consistent."""
    with (work / ".int-operation.lock").open("a") as handle:
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise RuntimeError(f"Another INT operation uses {work}; wait for it to finish") from None
        yield


def bootstrap(work):
    for name, source in LOCK["sources"].items():
        path = work / "sources" / name
        if not path.exists():
            path.parent.mkdir(parents=True, exist_ok=True)
            staging = Path(tempfile.mkdtemp(prefix=f".{name}-", dir=path.parent))
            try:
                run(["git", "init", staging])
                run(["git", "-C", staging, "remote", "add", "origin", source["url"]])
                run(["git", "-C", staging, "fetch", "--depth", "1", "origin", source["revision"]])
                run(["git", "-C", staging, "checkout", "--detach", "FETCH_HEAD"])
                staging.rename(path)
            finally:
                if staging.exists():
                    shutil.rmtree(staging)
        origin = subprocess.check_output(["git", "-C", path, "remote", "get-url", "origin"], text=True).strip()
        head = subprocess.check_output(["git", "-C", path, "rev-parse", "HEAD"], text=True).strip()
        dirty = subprocess.check_output(["git", "-C", path, "status", "--porcelain"], text=True)
        if origin != source["url"] or head != source["revision"] or dirty:
            raise RuntimeError(f"{path}: unexpected revision or local changes; preserve and inspect it")


def build_directory(profile):
    if profile not in ("core", "desktop", "feed", "live", "browser"):
        raise RuntimeError(f"Unknown build profile: {profile}")
    return {"core": "build", "desktop": "build-desktop", "feed": "build-feed", "live": "build-live",
            "browser": "build-browser"}[profile]


def configure(work, profile="core"):
    if not (work / "sources/openembedded-core/oe-init-build-env").is_file():
        raise RuntimeError("Run bootstrap first")
    conf = work / build_directory(profile) / "conf"
    conf.mkdir(parents=True, exist_ok=True)
    files = {
        "bblayers.conf": '''# Generated by scripts/int configure.
LCONF_VERSION = "7"
BBPATH = "${TOPDIR}"
BBFILES ?= ""
BBLAYERS = "/work/sources/openembedded-core/meta /work/sources/meta-openembedded/meta-oe /work/sources/meta-openembedded/meta-python /work/sources/meta-openembedded/meta-networking /src/meta-int"
''',
        "local.conf": '''# Generated by scripts/int configure. Private overrides: int-local.conf.
MACHINE = "qemux86-64"
DISTRO = "int-linux"
# Upstream qemux86-64 defaults to x86-64-v3. INT does not require AVX.
DEFAULTTUNE = "x86-64"
PACKAGE_CLASSES = "package_rpm"
DL_DIR = "/work/downloads"
SSTATE_DIR = "/work/sstate-cache"
BB_HASHSERVE_DB_DIR = "${SSTATE_DIR}"
# Prefer the official source mirror for archives; BitBake still checks hashes.
PREMIRRORS:prepend = "https?://.*/.* https://downloads.yoctoproject.org/mirror/sources/ \\n ftp://.*/.* https://downloads.yoctoproject.org/mirror/sources/ \\n"
BB_GIT_SHALLOW = "1"
BB_GIT_SHALLOW_DEPTH = "1"
# The first milestone needs one CPU architecture and serial emulation only.
QEMU_TARGETS = "x86_64"
PACKAGECONFIG:pn-qemu-system-native = "pie slirp pixman"
BB_NUMBER_THREADS = "4"
PARALLEL_MAKE = "-j4"
INHERIT += "rm_work"
BB_DISKMON_DIRS = "STOPTASKS,${TMPDIR},5G,100K HALT,${TMPDIR},2G,50K"
CONF_VERSION = "2"
# Do not expose forwarded host ports from the test VM.
QB_SLIRP_OPT = "-netdev user,id=net0"
require conf/distro/include/int-kernel-pins.inc
include int-local.conf
''',
    }
    if profile in ("desktop", "live", "browser"):
        files["bblayers.conf"] = files["bblayers.conf"].replace(
            '/src/meta-int"', '/src/meta-int /work/sources/meta-wayland /src/meta-int-desktop"')
        files["local.conf"] = files["local.conf"].replace(
            "include int-local.conf", "require conf/distro/include/int-desktop.inc\ninclude int-local.conf")
        if profile in ("live", "browser"):
            # Real-hardware UEFI live/installer ISO on top of the shared desktop.
            files["local.conf"] = files["local.conf"].replace(
                "include int-local.conf", "require conf/distro/include/int-live.inc\ninclude int-local.conf")
        if profile == "browser":
            # OS-INT browser ISO: the live image plus Firefox from meta-browser.
            files["bblayers.conf"] = files["bblayers.conf"].replace(
                '/src/meta-int-desktop"', '/src/meta-int-desktop /work/sources/meta-browser/meta-firefox"')
            files["local.conf"] = files["local.conf"].replace(
                "include int-local.conf", "require conf/distro/include/int-browser.inc\ninclude int-local.conf")
    elif profile == "feed":
        files["local.conf"] = files["local.conf"].replace(
            "include int-local.conf", 'require conf/distro/include/int-feed-lab.inc\ninclude int-local.conf')
    for name, contents in files.items():
        target = conf / name
        if target.exists() and target.read_text() != contents:
            raise RuntimeError(f"Refusing to overwrite {target}; put overrides in int-local.conf")
        target.write_text(contents)


def container(work, command, interactive=False, profile="core"):
    args = ["run", "--rm", "--init", "--security-opt", "seccomp=unconfined", *network_args(),
            "--user", f"{os.getuid()}:{os.getgid()}",
            "--mount", f"type=bind,src={REPO},dst=/src,readonly",
            "--mount", f"type=bind,src={work},dst=/work"]
    ca = Path("/etc/ssl/certs/ca-certificates.crt")
    if ca.is_file():
        args += ["--mount", f"type=bind,src={ca},dst=/etc/ssl/certs/ca-certificates.crt,readonly"]
        for name in ("SSL_CERT_FILE", "REQUESTS_CA_BUNDLE", "GIT_SSL_CAINFO", "CURL_CA_BUNDLE"):
            args += ["-e", f"{name}=/etc/ssl/certs/ca-certificates.crt"]
    # Forward only non-secret trust paths; Docker keeps its configured proxy defaults.
    if interactive:
        args += ["-it"]
    script = '''export PATH=/work/sources/bitbake/bin:$PATH
export BB_ENV_PASSTHROUGH_ADDITIONS="${BB_ENV_PASSTHROUGH_ADDITIONS:-} SSL_CERT_FILE REQUESTS_CA_BUNDLE GIT_SSL_CAINFO CURL_CA_BUNDLE"
. /work/sources/openembedded-core/oe-init-build-env /work/@BUILD_DIRECTORY@ >/dev/null
exec "$@"
'''
    script = script.replace("@BUILD_DIRECTORY@", build_directory(profile))
    # OE's supported environment script reads optional unset variables.
    docker([*args, IMAGE, "bash", "-ec", script, "int", *command])


def parse_arguments(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--profile", choices=["core", "desktop", "feed", "live", "browser"], default="core")
    parser.add_argument("command", choices=["bootstrap", "builder", "configure", "build", "shell", "check", "smoke", "core-check", "desktop-check", "graphics-check", "feed-check", "run"])
    parser.add_argument("target", nargs="?",
                        help="build target; for feed-check, the fixture disk directory followed by runner options")
    # Not argparse.REMAINDER: it would also swallow "--profile" given after the
    # command, silently selecting the default profile for every other command.
    args, extra = parser.parse_known_args(argv)
    if extra and args.command not in ("feed-check", "run"):
        parser.error("unrecognized arguments: " + " ".join(extra))
    args.extra = extra
    return args


def main():
    args = parse_arguments()
    work = workdir()
    work.mkdir(parents=True, exist_ok=True)
    if args.command == "run":
        # Interactive QEMU on the host (it may need a display). It only reads
        # deployed artifacts and works on its own copies, so it takes no lock.
        run_args = ["--profile", "desktop" if args.profile == "desktop" else "core", "--workdir", work]
        if args.target:
            run_args += ["--image", args.target]
        command = [sys.executable, REPO / "scripts/qemu-run.py", *run_args, *args.extra]
        sys.exit(subprocess.run(list(map(str, command)), check=False).returncode)
    with operation_lock(work):
        dispatch(args, work)


def dispatch(args, work):
    profile = args.profile
    deploy = f"/work/{build_directory(profile)}/tmp/deploy/images/qemux86-64"
    if args.command == "bootstrap":
        bootstrap(work)
    elif args.command == "builder":
        if os.getuid() == 0:
            raise RuntimeError("Run the builder as a non-root development user")
        docker(["build", *network_args(), "--secret", "id=ca_bundle,src=/etc/ssl/certs/ca-certificates.crt",
                "--build-arg", f"BUILD_UID={os.getuid()}", "--build-arg", f"BUILD_GID={os.getgid()}",
                "-f", REPO / "containers/builder.Dockerfile", "-t", IMAGE, REPO / "containers"])
    elif args.command == "configure":
        configure(work, profile)
    elif args.command == "build":
        target = args.target or {"core": "int-image-smoke", "desktop": "int-image-desktop-smoke", "feed": "rpm-native", "live": "int-image-live",
                                 "browser": "int-image-osint-browser"}[profile]
        container(work, ["bitbake", target], profile=profile)
    elif args.command == "check":
        container(work, ["python3", "/src/scripts/check-config.py", "--profile", profile], profile=profile)
    elif args.command == "shell":
        container(work, ["bash"], interactive=True, profile=profile)
    elif args.command == "smoke":
        container(work, ["python3", "/src/scripts/qemu-smoke.py", deploy, "/work/evidence"], profile=profile)
    elif args.command == "core-check":
        container(work, ["python3", "/src/scripts/qemu-core-check.py", deploy, "/work/evidence"], profile=profile)
    elif args.command == "feed-check":
        if profile != "feed":
            raise RuntimeError("feed-check requires --profile feed")
        if not args.target:
            raise RuntimeError("feed-check requires a fixture disk directory under /work")
        container(work, ["python3", "/src/scripts/qemu-feed-check.py", deploy, args.target,
                         "/work/evidence", *getattr(args, "extra", [])], profile=profile)
    elif args.command == "desktop-check":
        if profile != "desktop":
            raise RuntimeError("desktop-check requires --profile desktop")
        container(work, ["python3", "/src/scripts/qemu-desktop-check.py", deploy, "/work/evidence"], profile=profile)
    elif args.command == "graphics-check":
        if profile != "desktop":
            raise RuntimeError("graphics-check requires --profile desktop")
        container(work, ["python3", "/src/scripts/qemu-graphics-check.py", deploy, "/work/evidence"], profile=profile)


if __name__ == "__main__":
    try:
        main()
    except (OSError, RuntimeError, subprocess.CalledProcessError) as error:
        print(f"error: {error}", file=sys.stderr)
        sys.exit(1)
